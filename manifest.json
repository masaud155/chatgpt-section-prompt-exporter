{
  "manifest_version": 3,
  "name": "ChatGPT Section Image Prompt Extractor",
  "version": "1.0.0",
  "description": "Extract [Section Image] prompts from ChatGPT-generated blog articles and copy or export them.",
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    },
    "default_popup": "popup.html",
    "default_title": "Section Image Prompt Extractor"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
